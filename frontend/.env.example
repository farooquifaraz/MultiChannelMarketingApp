# =========================================================================
# Frontend environment variables (Vite)
# Copy this file to ".env" and fill in real values per environment.
# NEVER commit .env to version control.
# All variables MUST be prefixed with VITE_ to be exposed to the app.
# =========================================================================

# Backend API base (no trailing slash)
VITE_API_URL=http://localhost:5211/api/v1

# Optional brand overrides (the live brand also fetches /public/brand at runtime,
# which lets admin change branding from the UI without rebuilding).
# VITE_BRAND_NAME=YourCompanyName
# VITE_BRAND_LOGO=https://yourcdn.com/logo.svg
# VITE_PRIMARY_COLOR=#4f46e5
