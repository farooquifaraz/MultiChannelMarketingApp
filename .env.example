# =========================================================================
# Backend environment variables (.NET API)
# Copy this file to ".env" and fill in real values per environment.
# NEVER commit .env to version control.
# =========================================================================

# JWT signing key — MUST be a strong random string of at least 32 characters.
# Generate one: openssl rand -base64 48
Jwt__SecretKey=__REPLACE_WITH_RANDOM_32_PLUS_CHAR_SECRET__
Jwt__Issuer=MarketingApp
Jwt__Audience=MarketingAppUsers
Jwt__ExpiryMinutes=60
Jwt__RefreshTokenExpiryDays=30

# PostgreSQL connection — production must use a strong password.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=marketingapp;Username=postgres;Password=__REPLACE_ME__;Pooling=true;MinPoolSize=5;MaxPoolSize=100

# Redis cache — leave default for localhost dev.
ConnectionStrings__Redis=localhost:6379,abortConnect=false

# Seq (structured logging) — optional, can be omitted.
Seq__ServerUrl=http://localhost:5341

# CORS — comma-separated list of allowed frontend origins.
AllowedOrigins=http://localhost:5173,http://localhost:3000
