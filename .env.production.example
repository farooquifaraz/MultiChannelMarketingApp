# =========================================================================
# PRODUCTION environment template — copy to ".env" on the VPS and fill in.
# NEVER commit the real .env to git.
#
# Generate strong random values:
#   JWT secret:        openssl rand -base64 48
#   Postgres password: openssl rand -base64 32  (no special chars that break URI)
# =========================================================================

# --- PostgreSQL (runs in docker, only reachable by other containers) ---
POSTGRES_DB=marketingapp
POSTGRES_USER=marketingapp
POSTGRES_PASSWORD=__CHANGE_ME_STRONG_RANDOM__

# --- JWT (signing key for issued tokens — MUST be 32+ chars) ---
JWT_SECRET_KEY=__CHANGE_ME_RANDOM_BASE64_48_CHARS__
JWT_ISSUER=MarketingApp
JWT_AUDIENCE=MarketingAppUsers
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_DAYS=30

# --- Public URLs (used by tracking pixel, click redirect, CORS, frontend bundle) ---
# After SSL is set up these should be https://
PUBLIC_API_URL=https://api.yourdomain.com
PUBLIC_APP_URL=https://app.yourdomain.com

# Comma-separated list — must include the frontend origin for CORS to allow it.
ALLOWED_ORIGINS=https://app.yourdomain.com
